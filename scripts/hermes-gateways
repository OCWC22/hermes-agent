#!/usr/bin/env bash
# hermes-gateways — fan a single command out to every Hermes gateway profile.
#
# Profiles are auto-discovered from the platform's service manager directory:
#   macOS:   ~/Library/LaunchAgents/ai.hermes.gateway*.plist
#   Linux:   ~/.config/systemd/user/hermes-gateway*.service
# The default profile is the unsuffixed unit ("ai.hermes.gateway" / "hermes-gateway").
# No hardcoded profile list — add a new profile, it shows up automatically.
#
# Usage:
#   hermes-gateways start|stop|restart|status|reload|update|logs|kill|list [extra args...]
#
# Examples:
#   hermes-gateways status
#   hermes-gateways restart
#   hermes-gateways logs           # tails every gateway log together
#   hermes-gateways update         # one `hermes update` + restart of every profile
#   hermes-gateways kill           # SIGTERM every running gateway process

set -u

LA_DIR="$HOME/Library/LaunchAgents"
SYSTEMD_DIR="$HOME/.config/systemd/user"
LOG_DIR="$HOME/.hermes/logs"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'; c_dim=$'\033[2m'; c_rst=$'\033[0m'

discover_profiles() {
  local f base profile
  if [ -d "$LA_DIR" ]; then
    for f in "$LA_DIR"/ai.hermes.gateway*.plist; do
      [ -e "$f" ] || continue
      base="$(basename "$f" .plist)"
      if [ "$base" = "ai.hermes.gateway" ]; then
        profile="__default__"
      else
        profile="${base#ai.hermes.gateway-}"
      fi
      echo "$profile"
    done
  fi
  if [ -d "$SYSTEMD_DIR" ]; then
    for f in "$SYSTEMD_DIR"/hermes-gateway*.service; do
      [ -e "$f" ] || continue
      base="$(basename "$f" .service)"
      if [ "$base" = "hermes-gateway" ]; then
        profile="__default__"
      else
        profile="${base#hermes-gateway-}"
      fi
      echo "$profile"
    done
  fi
}

run_for_profile() {
  local profile="$1"; shift
  local label
  if [ "$profile" = "__default__" ]; then
    label="default"
    echo "${c_dim}── hermes gateway $* (profile: $label)${c_rst}"
    hermes gateway "$@"
  else
    label="$profile"
    echo "${c_dim}── hermes --profile $profile gateway $* (profile: $label)${c_rst}"
    hermes --profile "$profile" gateway "$@"
  fi
}

cmd_list() {
  echo "Discovered Hermes gateway profiles:"
  local any=0
  while read -r p; do
    any=1
    if [ "$p" = "__default__" ]; then echo "  • default"; else echo "  • $p"; fi
  done < <(discover_profiles | awk '!seen[$0]++')
  if [ "$any" -eq 0 ]; then
    echo "  ${c_ylw}(none found — no gateway service installed yet)${c_rst}"
  fi
  return 0
}

cmd_logs() {
  local files=()
  while read -r p; do
    if [ "$p" = "__default__" ]; then
      files+=("$LOG_DIR/gateway.log" "$LOG_DIR/gateway.error.log")
    else
      files+=("$LOG_DIR/gateway-$p.log" "$LOG_DIR/gateway-$p.error.log")
    fi
  done < <(discover_profiles | awk '!seen[$0]++')
  local existing=()
  for f in "${files[@]}"; do [ -f "$f" ] && existing+=("$f"); done
  if [ "${#existing[@]}" -eq 0 ]; then
    echo "${c_ylw}No gateway log files found in $LOG_DIR${c_rst}"; return 1
  fi
  exec tail -F "${existing[@]}"
}

cmd_kill() {
  echo "${c_ylw}SIGTERM every hermes gateway process (won't touch launchd/systemd)…${c_rst}"
  if pkill -TERM -f "hermes_cli.main.* gateway run"; then
    echo "${c_grn}sent.${c_rst}"
  else
    echo "${c_dim}no matching processes.${c_rst}"
  fi
}

fan_out() {
  local action="$1"; shift
  local profiles=()
  while read -r p; do profiles+=("$p"); done < <(discover_profiles | awk '!seen[$0]++')
  if [ "${#profiles[@]}" -eq 0 ]; then
    echo "${c_ylw}No gateway profiles found.${c_rst}"; return 1
  fi
  local rc=0
  for p in "${profiles[@]}"; do
    if ! run_for_profile "$p" "$action" "$@"; then rc=1; fi
  done
  return $rc
}

cmd_update() {
  echo "${c_grn}== hermes update ==${c_rst}"
  hermes update || { echo "${c_red}hermes update failed${c_rst}"; return 1; }
  echo
  echo "${c_grn}== restarting every gateway ==${c_rst}"
  fan_out restart
}

usage() {
  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
  echo
  echo "Discovered profiles right now:"
  cmd_list | sed 's/^/  /'
}

main() {
  local action="${1:-}"; shift || true
  case "$action" in
    ""|-h|--help|help) usage ;;
    list)              cmd_list ;;
    logs)              cmd_logs ;;
    kill)              cmd_kill ;;
    update)            cmd_update ;;
    start|stop|restart|status|reload)
                       fan_out "$action" "$@" ;;
    *)
      echo "${c_red}Unknown action:${c_rst} $action" >&2
      echo
      usage
      exit 2
      ;;
  esac
}

main "$@"
